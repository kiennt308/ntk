---
layout: null
permalink: /search.json
---
[
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date: '%b %d, %Y' | jsonify }},
      "category": {{ post.categories | first | default: "Guide" | jsonify }},
      "tags": {{ post.tags | default: empty_array | jsonify }},
      "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | escape | truncate: 160 | jsonify }},
      "content": {{ post.content | strip_html | strip_newlines | truncatewords: 300 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
